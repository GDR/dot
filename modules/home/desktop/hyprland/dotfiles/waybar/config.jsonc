[
    {
        "include": [
            "~/.config/waybar/base.jsonc"
        ],
        "output": "DP-3",
        "custom/focus-glow": {
            "exec": "sh -c 'mon=$(hyprctl activemonitor -j 2>/dev/null | sed -n \"s/.*\\\"name\\\": \\\"\\([^\\\"]*\\)\\\".*/\\1/p\" | head -n1); if [ \"$mon\" = \"DP-3\" ]; then echo \"{\\\"text\\\":\\\" \\\",\\\"class\\\":\\\"focused\\\"}\"; else echo \"{\\\"text\\\":\\\"\\\",\\\"class\\\":\\\"unfocused\\\"}\"; fi'",
            "return-type": "json",
            "signal": 10,
            "tooltip": false
        }
    },
    {
        "include": [
            "~/.config/waybar/base.jsonc"
        ],
        "output": "DP-2",
        "custom/focus-glow": {
            "exec": "sh -c 'mon=$(hyprctl activemonitor -j 2>/dev/null | sed -n \"s/.*\\\"name\\\": \\\"\\([^\\\"]*\\)\\\".*/\\1/p\" | head -n1); if [ \"$mon\" = \"DP-2\" ]; then echo \"{\\\"text\\\":\\\" \\\",\\\"class\\\":\\\"focused\\\"}\"; else echo \"{\\\"text\\\":\\\"\\\",\\\"class\\\":\\\"unfocused\\\"}\"; fi'",
            "return-type": "json",
            "signal": 10,
            "tooltip": false
        }
    },
    {
        "include": [
            "~/.config/waybar/base.jsonc"
        ],
        "output": "DP-1",
        "custom/focus-glow": {
            "exec": "sh -c 'mon=$(hyprctl activemonitor -j 2>/dev/null | sed -n \"s/.*\\\"name\\\": \\\"\\([^\\\"]*\\)\\\".*/\\1/p\" | head -n1); if [ \"$mon\" = \"DP-1\" ]; then echo \"{\\\"text\\\":\\\" \\\",\\\"class\\\":\\\"focused\\\"}\"; else echo \"{\\\"text\\\":\\\"\\\",\\\"class\\\":\\\"unfocused\\\"}\"; fi'",
            "return-type": "json",
            "signal": 10,
            "tooltip": false
        }
    }
]
